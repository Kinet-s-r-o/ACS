# ACS Frontend Configuration
# Copy this file to .env.production (or .env.local for development) and adjust values.
# These are build-time variables: Vite inlines them into the bundle at `npm run build`.

# Base URL of the backend API. Use /api when the frontend and API share a host.
VITE_API_URL=/api

# Brand name shown in the sidebar, login screen, and browser tab. Defaults to SkydashNET.
VITE_APP_NAME=
