# Standalone Docker deployment settings.
# Copy this file to .env.docker and replace every example value.

TZ=Europe/Bratislava

# Public DNS names. Both names must resolve to this host before starting TLS.
ACS_DOMAIN=acs.example.com
CWMP_DOMAIN=cwmp.example.com
LETSENCRYPT_EMAIL=admin@example.com
VITE_APP_NAME=ACS

# Application and database secrets. Generate unique values for production.
DB_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
PARAMETER_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
INITIAL_ADMIN_PASSWORD=

# Optional administrator source-network allowlist for the web login.
ADMIN_WEB_ALLOWED_CIDRS=

# Optional CWMP and network restrictions.
CWMP_USERNAME=
CWMP_PASSWORD=
CWMP_ALLOWED_CIDRS=
CONNECTION_REQUEST_ALLOWED_CIDRS=
TRUSTED_PROXY_CIDRS=172.16.0.0/12
CWMP_TRUSTED_PROXY_CIDRS=172.16.0.0/12
TRAEFIK_LOG_LEVEL=INFO
